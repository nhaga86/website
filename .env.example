# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Business Creationality"
# Comma separated list of emails that get /admin access
ADMIN_EMAILS=you@example.com

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use your own Stripe Price IDs. Leave empty to use inline prices ($20/mo, $190 lifetime).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
# Percentage the platform keeps on every product sale
PLATFORM_FEE_PERCENT=10

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Business Creationality <delivery@yourdomain.com>"

# Optional: auto-register creator custom domains on your Vercel project
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional: separate signing secret if you add a second webhook endpoint for Connect events
STRIPE_CONNECT_WEBHOOK_SECRET=
